# Anthropic Claude API key — used client-side to stream stories.
# Get one at https://console.anthropic.com
VITE_ANTHROPIC_API_KEY=

# Google OAuth Client ID — used for Google Sign-In.
# Get one at https://console.cloud.google.com (OAuth 2.0 Client ID, type "Web application")
VITE_GOOGLE_CLIENT_ID=

# Razorpay public key ID — used by the frontend checkout widget.
# Get it at https://dashboard.razorpay.com (Settings > API Keys)
VITE_RAZORPAY_KEY_ID=

# Supabase — real accounts, credits, and the admin CRM.
# Get these at https://supabase.com/dashboard/project/_/settings/api
# 1. Create a project, run supabase/schema.sql once in its SQL Editor.
# 2. Authentication > Providers > Google: enable it and add your
#    VITE_GOOGLE_CLIENT_ID above to "Authorized Client IDs".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (used by api/*.js — never sent to the browser) ---
# These only run when deployed to Vercel (or via `vercel dev`), not under plain `vite dev`.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Supabase "service_role" secret key (same project as above) — grants full DB
# access, used only server-side to credit accounts after a verified payment.
SUPABASE_SERVICE_ROLE_KEY=
